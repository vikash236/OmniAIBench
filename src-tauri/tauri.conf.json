{
    "$schema": "https://schema.tauri.app/config/2.0.0",
    "productName": "OmniAIBench",
    "version": "1.0.0",
    "identifier": "com.omniaibench.app",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon.ico",
            "icons/icon.png"
        ],
        "resources": [
            "../backend/**/*.py",
            "../backend/requirements.txt",
            "../OmniHardwareMonitor/bin/Release/net8.0/win-x64/publish/*",
            "launcher.ps1",
            "OmniAIBench-Launcher.bat"
        ],
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": "",
            "webviewInstallMode": {
                "type": "embedBootstrapper"
            },
            "wix": {
                "language": "en-US"
            },
            "nsis": {}
        }
    },
    "app": {
        "windows": [
            {
                "title": "OmniAIBench",
                "width": 1400,
                "height": 900,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "center": true
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "**"
                ]
            }
        }
    },
    "plugins": {}
}